--- !u!114 &2106401609
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2106401608}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0838774d98032454bb7e5f4ce8ae16ac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - speakerName: Helmet Statue
    portrait: {fileID: -1711806156, guid: 344cb1b9ba5c4b540a6d80d484f4e76a, type: 3}
    text: Ah, a vibrant warrior comes to save our land from this apocalypse.
  - speakerName: Lucerna
    portrait: {fileID: 1953571637, guid: daf994ec40988d54f985ff03748950bc, type: 3}
    text: Didn't I JUST see you?
  - speakerName: Helmet Statue
    portrait: {fileID: -1711806156, guid: 344cb1b9ba5c4b540a6d80d484f4e76a, type: 3}
    text: Heh, you must've met one of my twin brothers!
  - speakerName: Lucerna
    portrait: {fileID: -1711806156, guid: 344cb1b9ba5c4b540a6d80d484f4e76a, type: 3}
    text: There are more??
  - speakerName: Helmet Statue
    portrait: {fileID: -1711806156, guid: 344cb1b9ba5c4b540a6d80d484f4e76a, type: 3}
    text: Indeed there are, but I am by far the best.
  - speakerName: Helmet Statue
    portrait: {fileID: -1711806156, guid: 344cb1b9ba5c4b540a6d80d484f4e76a, type: 3}
    text: Go fourth, warrior! Learn more and save this world from this Apocalypse!
  interactPrompt: {fileID: 554891396}
  bobSpeed: 1.5
  bobAmount: 0.05
  playerTag: Player
