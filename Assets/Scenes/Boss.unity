--- !u!114 &420406368
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 420406366}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0838774d98032454bb7e5f4ce8ae16ac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - speakerName: Lucerna
    portrait: {fileID: 1953571637, guid: daf994ec40988d54f985ff03748950bc, type: 3}
    text: Oh wow! Finally something different.
  - speakerName: Lucerna
    portrait: {fileID: -2092019581, guid: daf994ec40988d54f985ff03748950bc, type: 3}
    text: "Purply\u2026.. kinda like jelly\u2026"
  - speakerName: MUNDO
    portrait: {fileID: 21300000, guid: 32373b5cf8baa1b4dae45d238db998b3, type: 3}
    text: I AM MUNDOOO! Fear me and my jell-
  - speakerName: ???
    portrait: {fileID: -2079718300, guid: daf994ec40988d54f985ff03748950bc, type: 3}
    text: '*nom*'
  - speakerName: MUNDO
    portrait: {fileID: 21300000, guid: 32373b5cf8baa1b4dae45d238db998b3, type: 3}
    text: "HEY! I am not some food for you to eat. I am the divine being MUNDO! The
      world\u2019s color is all mine\u2026 If you don\u2019t pass me, don\u2019t
      even THINK about helping out those lame statues\u2026"
  - speakerName: Lucerna
    portrait: {fileID: -580572323, guid: daf994ec40988d54f985ff03748950bc, type: 3}
    text: "Oh the statues? Baa most of them are boring, well except for the warrior
      brothers\u2026 they were pretty cool\u2026"
  - speakerName: Lucerna
    portrait: {fileID: -1831384829, guid: daf994ec40988d54f985ff03748950bc, type: 3}
    text: "But I'm mostly doing it for the taste!! After all, taste is just the \u2018color\u2019
      of the tongue.."
  interactPrompt: {fileID: 1641809852}
  bobSpeed: 1.5
  bobAmount: 0.05
  playerTag: Player
