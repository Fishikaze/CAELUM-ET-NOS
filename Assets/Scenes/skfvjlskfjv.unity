--- !u!114 &751332915
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 751332914}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0838774d98032454bb7e5f4ce8ae16ac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  lines:
  - speakerName: ???
    portrait: {fileID: 1953571637, guid: daf994ec40988d54f985ff03748950bc, type: 3}
    text: Where... am I?
  - speakerName: ???
    portrait: {fileID: -2092019581, guid: daf994ec40988d54f985ff03748950bc, type: 3}
    text: '*looks around*'
  - speakerName: ???
    portrait: {fileID: -2092019581, guid: daf994ec40988d54f985ff03748950bc, type: 3}
    text: Why is... everything is so... grey.
  - speakerName: ???
    portrait: {fileID: 955586193, guid: daf994ec40988d54f985ff03748950bc, type: 3}
    text: Ugh... how annoying.
  - speakerName: ???
    portrait: {fileID: -580572323, guid: daf994ec40988d54f985ff03748950bc, type: 3}
    text: Oooh! What is this little thing?
  - speakerName: Statue
    portrait: {fileID: -1235195791, guid: 344cb1b9ba5c4b540a6d80d484f4e76a, type: 3}
    text: Hey! Stop shaking me!
  - speakerName: ???
    portrait: {fileID: -580572323, guid: daf994ec40988d54f985ff03748950bc, type: 3}
    text: What the?? You can talk???
  - speakerName: Statue
    portrait: {fileID: -1235195791, guid: 344cb1b9ba5c4b540a6d80d484f4e76a, type: 3}
    text: "Well duh\u2026don\u2019t shake people who you don\u2019t even know!"
  - speakerName: Statue
    portrait: {fileID: -1235195791, guid: 344cb1b9ba5c4b540a6d80d484f4e76a, type: 3}
    text: ...
  - speakerName: Statue
    portrait: {fileID: -1235195791, guid: 344cb1b9ba5c4b540a6d80d484f4e76a, type: 3}
    text: Wow, its been a while since my eyes have seen such a vibrant color..
  - speakerName: Statue
    portrait: {fileID: -1235195791, guid: 344cb1b9ba5c4b540a6d80d484f4e76a, type: 3}
    text: "You should go visit Mr. Angel over there, he\u2019ll be a lot more help
      than I\u2026"
  - speakerName: Statue
    portrait: {fileID: -1235195791, guid: 344cb1b9ba5c4b540a6d80d484f4e76a, type: 3}
    text: ...colors... ...wow...
  - speakerName: Statue
    portrait: {fileID: -1831384829, guid: daf994ec40988d54f985ff03748950bc, type: 3}
    text: Okay!! Bye bye Mr. Statue!!
  - speakerName: Statue
    portrait: {fileID: -1235195791, guid: 344cb1b9ba5c4b540a6d80d484f4e76a, type: 3}
    text: Hey! PUT ME BACK ON MY PEDASTA-
  interactPrompt: {fileID: 1817284844}
  bobSpeed: 1.5
  bobAmount: 0.05
  playerTag: Player
